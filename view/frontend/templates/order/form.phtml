        <div class="actions-toolbar">
            <div class="primary"><button type="submit" class="action primary"><span><?= $escaper->escapeHtml(__('Add to Cart')) ?></span></button></div>
            <div class="secondary"><button type="submit" name="return_to_cart" value="1" class="action secondary"><span><?= $escaper->escapeHtml(__('Add and View Cart')) ?></span></button></div>
