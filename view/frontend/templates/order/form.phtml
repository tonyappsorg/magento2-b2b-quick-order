/** @var \Magento\Framework\Escaper $escaper */
?>
<div class="b2b-quick-order">
    <p><?= $escaper->escapeHtml(__('Enter one SKU and quantity per line, or upload a CSV with sku and qty columns.')) ?></p>
    <form action="<?= $escaper->escapeUrl($block->getUrl('b2bquickorder/order/add')) ?>" method="post" enctype="multipart/form-data">
        <?= $block->getBlockHtml('formkey') ?>
        <fieldset class="fieldset">
            <div class="field items required">
                <label class="label" for="quick-order-items"><span><?= $escaper->escapeHtml(__('SKUs and quantities')) ?></span></label>
                <div class="control">
                    <textarea id="quick-order-items" name="items" rows="10" placeholder="SKU-1001, 2&#10;SKU-1002, 1"></textarea>
                </div>
                <div class="note"><?= $escaper->escapeHtml(__('Use comma-separated SKU and quantity values. Example: SKU-1001, 2')) ?></div>
